+def amplify_fixed_error(target_success_probability, r, stddev, other_probability=1.0, quantiles=256):
+    """
+    Number of attempts on ONE instance needed to reach ``target_success_probability`` when only the
+    reduced basis is re-randomised between attempts, so the error vector (and its norm) is the same in every
+    attempt.
+
+    Attempts are independent given the error norm: with ``‖e‖² ~ stddev² · χ²_d`` (``d = len(r)``), one
+    attempt succeeds with probability ``other_probability · babai(r, ‖e‖)``, and we return the smallest ``k``
+    with ``E[(1 - other_probability · babai(r, ‖e‖))^k] ≤ 1 - target_success_probability``.
+
+    By Jensen's inequality this is never smaller than ``amplify(target, E[...])``, the independent-trials
+    count. ``babai`` is the per-level product, which is at least the exact fixed-norm success probability
+    (the levels are negatively dependent at a fixed norm), so the result is a lower bound on the attempts
+    under the fixed-norm model: conservative for security estimates.
+
+    :param target_success_probability: target overall success probability < 1.
+    :param r: squared Gram-Schmidt norms of the reduced basis.
+    :param stddev: standard deviation of each error coordinate.
+    :param other_probability: success probability of the other, norm-independent parts of an attempt
+        (e.g. the guessing hit probability).
+    :param quantiles: number of χ² quantiles used for the expectation.
+
+    EXAMPLES::
+
+        >>> from estimator.prob import amplify, amplify_fixed_error
+        >>> r = [4.0**2] * 20 + [2.2**2] * 20
+        >>> k_fixed = amplify_fixed_error(0.99, r, 1.0)
+        >>> k_fixed >= amplify(0.99, babai(r, 40**0.5))
+        True
+
+    """
+    from scipy.special import betainc
+    from scipy.stats import chi2
+    import numpy as np
+
+    d = len(r)
+    rr = np.array([float(x) for x in r])
+    radii2 = float(stddev) ** 2 * chi2.ppf((np.arange(quantiles) + 0.5) / quantiles, d)
+    x = np.minimum(1.0, rr[None, :] / (4.0 * radii2[:, None]))
+    logp = np.log(np.maximum(betainc(0.5, (d - 1) / 2.0, x), 1e-300)).sum(1)
+    p = float(other_probability) * np.exp(logp)
+    if p.max() <= 0:
+        return oo
+    log_fail = np.log1p(-np.minimum(p, 1 - 1e-16))
+
+    def fail(k):
+        return float(np.mean(np.exp(k * log_fail)))
+
+    target = 1 - float(target_success_probability)
+    if fail(1) <= target:
+        return ZZ(1)
+    lo, hi = 1, 2
+    while fail(hi) > target:
+        lo, hi = hi, hi * 2
+        if hi > 2**200:
+            return oo
+    while hi - lo > 1:
+        mid = (lo + hi) // 2
+        lo, hi = (mid, hi) if fail(mid) > target else (lo, mid)
+    return ZZ(hi)
+
+
